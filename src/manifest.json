{
    "manifest_version": 3,
    "name": "Ai Chat Automation (Grok Update)",
    "version": "5.0",
    "description": "AI chat bot",
    "permissions": [
        "storage",
        "scripting",
        "tabs",
        "activeTab",
        "webRequest"
    ],
    "host_permissions": [
        "https://chat.freedomgpt.com/*",
        "https://agents.moderationinterface.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://agents.moderationinterface.com/*",
                "https://chat.freedomgpt.com/*",
                "http://localhost/*",
                "http://127.0.0.1/*",
                "file:///*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "index.html"
    }
}